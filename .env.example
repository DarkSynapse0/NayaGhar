# Database (Neon PostgreSQL with pgvector)
# DATABASE_URL = high-privilege owner role (BYPASSRLS). Used by:
#   - drizzle-kit migrate / push / generate
#   - npm run db:rls
#   - npm run db:create-app-role
#   - src/lib/db/seed.ts
DATABASE_URL=postgresql://user:password@host/naya_ghar
# APP_DATABASE_URL = app_user role (NOBYPASSRLS). Used by the Next.js runtime
# so RLS policies actually enforce. Bootstrap with `npm run db:create-app-role`.
# If unset, the app falls back to DATABASE_URL (RLS becomes documentation only).
APP_DATABASE_URL=postgresql://app_user:GENERATED_PASSWORD@host/naya_ghar

# Auth
AUTH_SECRET=your-auth-secret-here
AUTH_URL=http://localhost:3000

# Embedding Service
EMBEDDING_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=sk-your-key-here

# Cloudinary (image & video cloud storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# WhatsApp Cloud API
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ─────────────────────────────────────────────────────────────────
# Solana
# ─────────────────────────────────────────────────────────────────
# Used for: on-chain reputation program (and Phase 2 attestations).
# Not used for payments — money flows through Esewa/Khalti only.

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Reputation program id (set after `cd solana && anchor deploy`).
# Until deployed, the loader falls back to System Program with a warning.
# REPUTATION_PROGRAM_ID=YourReputationProgramIdAfterDeploy

# KEK for envelope-encrypting user custodial wallet secret keys.
# Generate: openssl rand -base64 32
WALLET_KEK_BASE64=replace-me-32-bytes-base64
WALLET_KEK_ID=hackathon-local-v1

# Esewa ePay v2
# Sandbox merchant code: EPAYTEST, secret: 8gBm/:&EnhH.1/q
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Khalti KPG-2
# Sandbox base: https://dev.khalti.com  Live: https://khalti.com
KHALTI_SECRET_KEY=replace-me-test-secret-key
KHALTI_BASE_URL=https://dev.khalti.com

# Cron / job processor auth (any caller of /api/jobs/* must send this in X-Cron-Secret header).
CRON_SECRET=replace-me-random-string

# Public site URL (used to build Esewa/Khalti success/failure return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
